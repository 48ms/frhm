# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=your-cron-secret

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_BOT_SECRET_TOKEN=your-webhook-secret-token
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=FrhmBot
TELEGRAM_ADMIN_CHAT_ID=your-admin-chat-id
TELEGRAM_LINK_SECRET=your-telegram-link-secret
ADMIN_TELEGRAM_CHAT_ID=your-admin-chat-id

# Ayrshare (social publishing + analytics)
AYRSHARE_API_KEY=your-ayrshare-api-key
AYRSHARE_WEBHOOK_SECRET=your-ayrshare-webhook-signing-secret
OAUTH_STATE_SECRET=your-oauth-state-secret

# Review portal signed links (minimum 32 characters)
REVIEW_LINK_SECRET=your-review-link-secret

# WoopSocial bridge
BRIDGE_API_KEY=your-bridge-api-key

# WhatsApp Cloud API
WHATSAPP_API_TOKEN=your-whatsapp-api-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token
WHATSAPP_WEBHOOK_URL=your-webhook-url

# Cloudinary (media uploads)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_UPLOAD_PRESET=your-upload-preset

# AI provider defaults (optional; DB provider takes precedence)
AI_DEFAULT_MODEL=gpt-4o-mini
AI_DEFAULT_BASE_URL=http://localhost:11434/v1
AI_DEFAULT_API_KEY=ollama

# Meta / Instagram Graph API Direct OAuth (Optional if using direct Meta App)
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_REDIRECT_URI=https://your-domain.com/api/social/instagram/callback

# Sentry (Observability & Error Tracking)
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn.ingest.sentry.io/your-project
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# Logging
LOG_LEVEL=info


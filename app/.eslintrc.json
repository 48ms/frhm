{
  "extends": [
    "next/core-web-vitals",
    "next/typescript"
  ],
  "ignorePatterns": [
    "scripts/**",
    "e2e/**",
    "apply_migration.js"
  ],
  "rules": {
    "react/no-unescaped-entities": "off",
    "react/no-children-prop": "off",
    "@typescript-eslint/no-explicit-any": "warn",
    "@typescript-eslint/no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ],
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": [
              "@supabase/supabase-js"
            ],
            "message": "Use lib/supabase/server.ts or lib/supabase/client.ts instead of direct import"
          }
        ],
        "paths": [
          {
            "name": "campaigns",
            "message": "Use 'content_campaigns' instead. 'campaigns' is a legacy view for backward compatibility only."
          },
          {
            "name": "content_metrics",
            "message": "Use 'post_metrics' instead. 'content_metrics' is a legacy view for backward compatibility only."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "test/**"
      ],
      "rules": {
        "@typescript-eslint/no-explicit-any": "off",
        "@typescript-eslint/no-unused-vars": "off"
      }
    },
    {
      "files": [
        "lib/supabase/service.ts",
        "lib/supabase/client.ts",
        "test-supabase.ts"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ]
}
